# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Postgres (default, matches docker-compose):
DATABASE_URL=postgresql+psycopg://meridian:meridian@localhost:5432/meridian
# Zero-setup local alternative (no Docker needed) — uncomment to use SQLite:
# DATABASE_URL=sqlite+pysqlite:///./meridian.db

# ---------------------------------------------------------------------------
# App secrets  (generate real values — see README §Google Cloud Setup step 6)
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ---------------------------------------------------------------------------
APP_SECRET=change-me-to-a-random-32-byte-string
TOKEN_ENCRYPTION_KEY=change-me-to-a-fernet-key

# ---------------------------------------------------------------------------
# Google OAuth
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=<oauth-client-id>
GOOGLE_CLIENT_SECRET=<oauth-client-secret>
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
OAUTH_SCOPES=openid email profile https://www.googleapis.com/auth/drive.file

# ---------------------------------------------------------------------------
# URLs
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Local development conveniences
# ---------------------------------------------------------------------------
# Lets you sign in as the seeded demo user without configuring Google Cloud.
# MUST be false in any deployed environment.
DEV_LOGIN_ENABLED=true
DEV_LOGIN_EMAIL=demo@meridian.local
# Cookies over plain HTTP for localhost. Set true when serving over HTTPS.
SESSION_COOKIE_SECURE=false
